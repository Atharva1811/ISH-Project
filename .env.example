# CampusFlora Frontend Environment Variables Template
# Copy this file to .env.local for local development.

# Supabase Connection (Public Anon Key is safe in frontend - RLS enforces security)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Supabase Edge Function Endpoint for Secure PlantNet AI Proxy
VITE_PLANTNET_EDGE_FUNCTION_URL=https://your-project-id.supabase.co/functions/v1/plantnet-proxy

# NOTE ON SECRETS MANAGEMENT:
# 1. PLANTNET_API_KEY: Set as a Supabase Secret in project dashboard/CLI:
#    supabase secrets set PLANTNET_API_KEY=your_plantnet_key
# 2. SUPABASE_SERVICE_ROLE_KEY: Set in GitHub Actions secrets for CI migrations if automated.
# 3. DO NOT put real API keys or service keys in this file or commit .env files!
